# Хостинг Timeweb кладёт в корень свою заглушку index.htm и отдаёт её
# первой. Эта строка говорит серверу открывать наш index.html.
# index.php нужен здесь же: на нём работает страница просмотра заявок,
# и без него Apache отдавал бы для её папки «доступ запрещён».
DirectoryIndex index.html index.php

# Принудительный HTTPS.
# Timeweb работает за прокси: сам сайт видит обычный HTTP, а о том, что
# посетитель пришёл по защищённому адресу, сообщает заголовок
# X-Forwarded-Proto. Поэтому проверяем и переменную HTTPS, и заголовок:
# перенаправляем только если ни то, ни другое не говорит про https.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP:X-Forwarded-SSL} !on [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Сколько держать файлы в памяти браузера.
# Страницы — не держать: правки на сайте должны быть видны сразу, иначе
# посетитель неделю смотрит старую версию и думает, что ничего не менялось.
# У стилей и скрипта в адресе стоит номер правки, он меняется на каждой
# выкладке — их можно держать долго, старый адрес просто перестаёт
# запрашиваться. Фото и видео меняются редко, им хватает недели.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|mp4|webm|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
